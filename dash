<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>새마을금고 경영 현황 대시보드</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.57.4/dist/umd/supabase.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.0/dist/chart.umd.min.js"></script>

  <style>
    :root {
      --bg: #f5f7fb;
      --card: #ffffff;
      --text: #172033;
      --muted: #6c7484;
      --border: #e6e9ef;
      --primary: #1f6feb;
      --shadow: 0 8px 24px rgba(24, 39, 75, 0.08);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Pretendard", "Noto Sans KR", "Malgun Gothic", Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    .wrap {
      width: min(1280px, calc(100% - 32px));
      margin: 32px auto 56px;
    }
    .header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
    }
    h1 {
      margin: 0;
      font-size: clamp(24px, 3vw, 36px);
      letter-spacing: -0.04em;
    }
    .sub {
      margin-top: 8px;
      color: var(--muted);
      font-size: 14px;
    }
    .refresh-btn {
      border: 0;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      padding: 11px 16px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }
    .refresh-btn:disabled { opacity: 0.55; cursor: wait; }
    .status {
      margin-bottom: 16px;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      font-size: 13px;
      color: var(--muted);
    }
    .status.error {
      color: #a12626;
      background: #fff6f6;
      border-color: #f0caca;
    }
    .kpis {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 20px;
    }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }
    .kpi { padding: 20px; }
    .kpi-label { color: var(--muted); font-size: 13px; margin-bottom: 10px; }
    .kpi-value {
      font-size: clamp(23px, 3vw, 32px);
      font-weight: 800;
      letter-spacing: -0.04em;
    }
    .charts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    .chart-card { padding: 20px; min-width: 0; }
    .chart-card.wide { grid-column: 1 / -1; }
    .chart-title { font-size: 17px; font-weight: 800; margin-bottom: 4px; }
    .chart-desc { color: var(--muted); font-size: 12px; margin-bottom: 16px; }
    .canvas-wrap { position: relative; height: 320px; }
    .table-wrap { margin-top: 20px; overflow-x: auto; }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
      font-size: 14px;
    }
    th, td {
      padding: 13px 14px;
      border-bottom: 1px solid var(--border);
      text-align: right;
      white-space: nowrap;
    }
    th:first-child, td:first-child { text-align: left; }
    th { color: var(--muted); font-size: 12px; background: #fafbfc; }
    @media (max-width: 900px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .charts { grid-template-columns: 1fr; }
      .chart-card.wide { grid-column: auto; }
    }
    @media (max-width: 560px) {
      .wrap { width: min(100% - 20px, 1280px); margin-top: 20px; }
      .header { align-items: stretch; flex-direction: column; }
      .refresh-btn { width: 100%; }
      .kpis { grid-template-columns: 1fr; }
      .canvas-wrap { height: 280px; }
    }
  </style>
</head>
<body>
  <main class="wrap">
    <section class="header">
      <div>
        <h1>새마을금고 경영 현황 대시보드</h1>
        <div class="sub">Supabase 실시간 조회 · 페이지를 열거나 새로고침할 때 최신 데이터를 다시 불러옵니다.</div>
      </div>
      <button id="refreshBtn" class="refresh-btn" type="button">최신 데이터 새로고침</button>
    </section>

    <div id="status" class="status">데이터를 불러오는 중입니다.</div>

    <section class="kpis">
      <article class="card kpi">
        <div class="kpi-label">전체 조합원 수</div>
        <div class="kpi-value" id="totalMembers">-</div>
      </article>
      <article class="card kpi">
        <div class="kpi-label">예적금 총액</div>
        <div class="kpi-value" id="totalDeposits">-</div>
      </article>
      <article class="card kpi">
        <div class="kpi-label">대출 총액</div>
        <div class="kpi-value" id="totalLoans">-</div>
      </article>
      <article class="card kpi">
        <div class="kpi-label">연체 건수</div>
        <div class="kpi-value" id="totalDelinquent">-</div>
      </article>
    </section>

    <section class="charts">
      <article class="card chart-card">
        <div class="chart-title">지점별 조합원 수</div>
        <div class="chart-desc">members.branch_id 기준</div>
        <div class="canvas-wrap"><canvas id="membersChart"></canvas></div>
      </article>

      <article class="card chart-card">
        <div class="chart-title">지점별 예적금 총액</div>
        <div class="chart-desc">deposit_accounts.balance 합계</div>
        <div class="canvas-wrap"><canvas id="depositsChart"></canvas></div>
      </article>

      <article class="card chart-card wide">
        <div class="chart-title">지점별 대출 총액 및 연체 건수</div>
        <div class="chart-desc">loan_amount 합계와 status='연체' 건수 비교</div>
        <div class="canvas-wrap"><canvas id="loansChart"></canvas></div>
      </article>
    </section>

    <section class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th>지점명</th>
            <th>조합원 수</th>
            <th>예적금 총액</th>
            <th>대출 총액</th>
            <th>연체 건수</th>
          </tr>
        </thead>
        <tbody id="summaryBody"></tbody>
      </table>
    </section>
  </main>

  <script>
    const SUPABASE_URL = "https://icggthyluhicpceuzdll.supabase.co";
    const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_tz0c3dJOw0IhnYpoxVVc6A_K28328SB";

    const client = supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);

    let membersChart;
    let depositsChart;
    let loansChart;

    const won = new Intl.NumberFormat("ko-KR", {
      style: "currency",
      currency: "KRW",
      maximumFractionDigits: 0
    });
    const number = new Intl.NumberFormat("ko-KR");

    function sum(values) {
      return values.reduce((acc, v) => acc + (Number(v) || 0), 0);
    }

    function formatShortWon(value) {
      const n = Number(value) || 0;
      if (Math.abs(n) >= 100000000) return `${(n / 100000000).toFixed(1)}억원`;
      if (Math.abs(n) >= 10000) return `${(n / 10000).toFixed(1)}만원`;
      return won.format(n);
    }

    function setStatus(message, isError = false) {
      const el = document.getElementById("status");
      el.textContent = message;
      el.classList.toggle("error", isError);
    }

    function destroyCharts() {
      if (membersChart) membersChart.destroy();
      if (depositsChart) depositsChart.destroy();
      if (loansChart) loansChart.destroy();
    }

    function buildCharts(rows) {
      destroyCharts();
      const labels = rows.map(r => r.branch_name);

      membersChart = new Chart(document.getElementById("membersChart"), {
        type: "bar",
        data: {
          labels,
          datasets: [{ label: "조합원 수", data: rows.map(r => r.member_count) }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: ctx => `${number.format(ctx.raw)}명` } }
          },
          scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
      });

      depositsChart = new Chart(document.getElementById("depositsChart"), {
        type: "bar",
        data: {
          labels,
          datasets: [{ label: "예적금 총액", data: rows.map(r => r.deposit_total) }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: ctx => won.format(ctx.raw) } }
          },
          scales: {
            y: { beginAtZero: true, ticks: { callback: value => formatShortWon(value) } }
          }
        }
      });

      loansChart = new Chart(document.getElementById("loansChart"), {
        type: "bar",
        data: {
          labels,
          datasets: [
            {
              label: "대출 총액(억원)",
              data: rows.map(r => r.loan_total / 100000000),
              yAxisID: "y"
            },
            {
              label: "연체 건수",
              data: rows.map(r => r.delinquent_count),
              yAxisID: "y1"
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          scales: {
            y: {
              beginAtZero: true,
              position: "left",
              title: { display: true, text: "대출 총액(억원)" }
            },
            y1: {
              beginAtZero: true,
              position: "right",
              grid: { drawOnChartArea: false },
              ticks: { precision: 0 },
              title: { display: true, text: "연체 건수" }
            }
          }
        }
      });
    }

    function renderTable(rows) {
      const tbody = document.getElementById("summaryBody");
      tbody.innerHTML = rows.map(r => `
        <tr>
          <td>${r.branch_name}</td>
          <td>${number.format(r.member_count)}명</td>
          <td>${won.format(r.deposit_total)}</td>
          <td>${won.format(r.loan_total)}</td>
          <td>${number.format(r.delinquent_count)}건</td>
        </tr>
      `).join("");
    }

    async function loadDashboard() {
      const btn = document.getElementById("refreshBtn");
      btn.disabled = true;
      setStatus("Supabase에서 최신 데이터를 조회하는 중입니다.");

      try {
        const [branchesRes, membersRes, depositsRes, loansRes] = await Promise.all([
          client.from("branches").select("branch_id, branch_name").order("branch_id"),
          client.from("members").select("member_id, branch_id"),
          client.from("deposit_accounts").select("account_id, branch_id, balance"),
          client.from("loans").select("loan_id, branch_id, loan_amount, status")
        ]);

        const responses = [branchesRes, membersRes, depositsRes, loansRes];
        const failed = responses.find(r => r.error);
        if (failed) throw failed.error;

        const branches = branchesRes.data || [];
        const members = membersRes.data || [];
        const deposits = depositsRes.data || [];
        const loans = loansRes.data || [];

        const rows = branches.map(branch => {
          const branchMembers = members.filter(x => x.branch_id === branch.branch_id);
          const branchDeposits = deposits.filter(x => x.branch_id === branch.branch_id);
          const branchLoans = loans.filter(x => x.branch_id === branch.branch_id);

          return {
            branch_name: branch.branch_name,
            member_count: branchMembers.length,
            deposit_total: sum(branchDeposits.map(x => x.balance)),
            loan_total: sum(branchLoans.map(x => x.loan_amount)),
            delinquent_count: branchLoans.filter(x => x.status === "연체").length
          };
        });

        document.getElementById("totalMembers").textContent = `${number.format(members.length)}명`;
        document.getElementById("totalDeposits").textContent = formatShortWon(sum(deposits.map(x => x.balance)));
        document.getElementById("totalLoans").textContent = formatShortWon(sum(loans.map(x => x.loan_amount)));
        document.getElementById("totalDelinquent").textContent =
          `${number.format(loans.filter(x => x.status === "연체").length)}건`;

        buildCharts(rows);
        renderTable(rows);

        setStatus(`최신 데이터 조회 완료 · ${new Date().toLocaleString("ko-KR")}`);
      } catch (error) {
        console.error(error);
        setStatus(
          `데이터 조회 실패: ${error && error.message ? error.message : "알 수 없는 오류"} · Supabase RLS/권한 및 네트워크 설정을 확인하세요.`,
          true
        );
      } finally {
        btn.disabled = false;
      }
    }

    document.getElementById("refreshBtn").addEventListener("click", loadDashboard);
    loadDashboard();
  </script>
</body>
</html>
